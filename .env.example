# Frontend: copy the relevant values into frontend/.env.local for Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_API_URL=http://localhost:8000

# Backend: set these in backend/.env or your deployment environment.
SUPABASE_URL=https://your-project-ref.supabase.co

# Local testing only. Keep disabled and unset in deployed environments.
VITE_ENABLE_DEV_LOGIN_BYPASS=false
ENABLE_DEV_LOGIN_BYPASS=false
DEV_LOGIN_BYPASS_SECRET=replace-with-a-long-random-local-secret
